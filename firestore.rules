rules_version = '2';

// DarthBarber - regras do Firestore (ETAPA 1)
//
// IMPORTANTE:
// - As rotas /api usam o Admin SDK e IGNORAM estas regras. Elas precisam
//   validar o login por conta própria (veja a Fase 1 da avaliação).
// - Teste no Emulator Suite ou no "Playground de regras" antes de publicar.
// - Se alguma tela ainda gravar direto em appointments/notifications,
//   ela passará a receber permission-denied: migre-a para a API.

service cloud.firestore {
  match /databases/{database}/documents {

    // ========== FUNÇÕES AUXILIARES ==========

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Barbeiro/Master: UID (não pode ser forjado) ou custom claim "barber".
    // Emails e o campo users/{uid}.role NÃO concedem mais privilégio.
    function isMaster() {
      return isAuthenticated() && (
        request.auth.token.get('barber', false) == true ||
        request.auth.uid in [
          '2cAVs3U9ciV3NiqApJuOlYGEJS32',
          'eUCAkXknM1N0mcC04hCIfF3HcMk1',
          'wWlt2ixyjwfLqDHDQFFNQgaYfCT2'
        ]
      );
    }

    // Campos que o próprio usuário pode alterar no perfil.
    // 'role' fica de fora de propósito.
    function onlyProfileFieldsChanged() {
      return request.resource.data.diff(resource.data).affectedKeys()
        .hasOnly(['name', 'email', 'phone', 'avatarUrl', 'themeColor', 'updatedAt']);
    }

    // ========== USUÁRIOS ==========

    match /users/{userId} {
      allow read: if isOwner(userId) || isMaster();

      // Cria o próprio perfil, mas nunca como barbeiro/admin.
      allow create: if isOwner(userId)
        && (!('role' in request.resource.data)
            || request.resource.data.role == 'client');

      // Personalização: nome, contato, foto e cor do tema.
      // avatarUrl aceita data URL pequena (foto reduzida no navegador).
      allow update: if isOwner(userId)
        && onlyProfileFieldsChanged()
        && (!('themeColor' in request.resource.data)
            || (request.resource.data.themeColor is string
                && request.resource.data.themeColor.size() <= 20))
        && (!('avatarUrl' in request.resource.data)
            || (request.resource.data.avatarUrl is string
                && request.resource.data.avatarUrl.size() <= 80000));

      allow delete: if isOwner(userId) || isMaster();
    }

    // ========== AGENDAMENTOS ==========
    // Criação e mudanças de status acontecem nas rotas /api (Admin SDK).

    match /appointments/{appointmentId} {
      // ETAPA 1 (mantém o app atual funcionando; o calendário ainda lê
      // os agendamentos direto do Firestore):
      allow read: if isAuthenticated();

      // ETAPA 2 (depois de migrar o calendário para /api/appointments/slots),
      // troque a linha acima por:
      // allow read: if isMaster()
      //   || (isAuthenticated() && resource.data.clientId == request.auth.uid);

      allow create: if false;
      allow update, delete: if isMaster();
    }

    // ========== NOTIFICAÇÕES ==========

    match /notifications/{notificationId} {
      allow read: if isAuthenticated()
        && (resource.data.toId == request.auth.uid || isMaster());

      // Quem recebe só pode marcar como lida.
      allow update: if isAuthenticated()
        && (resource.data.toId == request.auth.uid || isMaster())
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);

      // Criação só pelo servidor (Admin SDK) ou pelo barbeiro.
      allow create: if isMaster();

      allow delete: if isAuthenticated()
        && (resource.data.toId == request.auth.uid || isMaster());
    }

    // ========== BLOQUEIO GERAL ==========

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
