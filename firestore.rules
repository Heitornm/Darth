rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isMasterBarber() {
      return isSignedIn() && (
        request.auth.token.email == 'darthbarber@darth.com.br' ||
        request.auth.uid == 'eUCAkXknM1N0mcC04hCIfF3HcMk1'
      );
    }

    match /users/{userId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && (request.auth.uid == userId || isMasterBarber());
    }

    match /services/{serviceId} {
      allow read: if true;
      allow write: if isMasterBarber();
    }

    match /appointments/{appointmentId} {
      // Leitura pública para checagem de horários no calendário
      allow read: if true;
      
      // Apenas cria se for o próprio cliente criando ou o Barbeiro Master
      allow create: if isSignedIn() && (
        isMasterBarber() ||
        request.resource.data.clientId == request.auth.uid ||
        request.resource.data.userId == request.auth.uid
      );
      
      // Cliente só altera status para cancelamento. Edição geral apenas para o Barbeiro.
      allow update: if isSignedIn() && (
        isMasterBarber() || 
        (
          (resource.data.clientId == request.auth.uid || resource.data.userId == request.auth.uid) &&
          request.resource.data.status == 'solicitado_cancelamento'
        )
      );

      // Apenas Barbeiro Master pode deletar agendamentos do banco
      allow delete: if isMasterBarber();
    }

    match /notifications/{notificationId} {
      // 'read' cobre automaticamente 'get' e 'list'
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update, delete: if isSignedIn() && (
        isMasterBarber() ||
        resource.data.toId == request.auth.uid
      );
    }
    
    match /{path=**} {
      allow read, write: if false;
    }
  }
}