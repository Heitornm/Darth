rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ========== FUNÇÕES AUXILIARES DE SEGURANÇA ==========
    
    // Verifica se o usuário realizou autenticação
    function isAuthenticated() {
      return request.auth != null;
    }

    // Verifica se o usuário autenticado é o dono do próprio documento
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Verifica se o usuário autenticado possui e-mail ou UID com privilégios de Barbeiro/Master
    function isMaster() {
      return isAuthenticated() && (
        request.auth.token.email == 'heitormartins@gmail.com' ||
        request.auth.token.email == 'heitormartins@email.com' ||
        request.auth.token.email == 'darthbarbers@email.com' ||
        request.auth.token.email == 'darthbarber@gmail.com.br' ||
        request.auth.uid == '2cAVs3U9ciV3NiqApJuOlYGEJS32' ||
        request.auth.uid == 'eUCAkXknM1N0mcC04hCIfF3HcMk1' ||
        request.auth.uid == 'wWlt2ixyjwfLqDHDQFFNQgaYfCT2' ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'barber')
      );
    }

    // Valida alteração efetuada pelo cliente para solicitar cancelamento
    function clientePodeCancelar() {
      return request.resource.data.keys().hasOnly(['status', 'updatedAt']) &&
             request.resource.data.status == 'solicitado_cancelamento';
    }

    // ========== COLEÇÃO: USUÁRIOS ==========
    match /users/{userId} {
      allow read: if isOwner(userId) || isMaster();
      allow create: if isOwner(userId);
      allow update: if isOwner(userId) && !request.resource.data.hasRole;
      allow delete: if isMaster();
    }

    // ========== COLEÇÃO: AGENDAMENTOS ==========
    match /appointments/{appointmentId} {
      // Permite leitura para qualquer usuário autenticado (necessário para a grade de horários ocupados e painel do barbeiro)
      allow read: if isAuthenticated();
      
      // Permite criação se o usuário estiver autenticado e não tentar criar diretamente como finalizado
      allow create: if isAuthenticated() &&
        request.resource.data.status != 'confirmado' &&
        request.resource.data.status != 'concluido';

      // Permite atualização pelo dono para cancelar ou pelo barbeiro/master para aprovar e gerenciar
      allow update: if isAuthenticated() && (
        (resource.data.clientId == request.auth.uid && clientePodeCancelar()) ||
        isMaster()
      );
      
      // Exclusão permitida apenas para o barbeiro/master
      allow delete: if isMaster();
    }

    // ========== COLEÇÃO: NOTIFICAÇÕES ==========
    match /notifications/{notificationId} {
      allow read: if isAuthenticated() && (
        resource.data.toId == request.auth.uid || isMaster()
      );
      allow create: if isAuthenticated();
      allow update: if isAuthenticated() && (
        resource.data.toId == request.auth.uid || isMaster()
      );
      allow delete: if isMaster();
    }

    // ========== BLOQUEIO GERAL DE SEGURANÇA ==========
    match /{document=**} {
      allow read, write: if false;
    }
  }
}