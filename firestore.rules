rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ========== FUNÇÕES AUXILIARES ==========
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isMaster() {
      return isAuthenticated() && (
        request.auth.token.email == 'heitornmartins@gmail.com' ||
        request.auth.token.email == 'darthbarber@darth.com.br' ||
        request.auth.uid == 'eUCAkXknM1N0mcC04hCIfF3HcMk1' ||
        request.auth.uid == 'wWlt2ixyjwfLqDHDQFFNQgaYfCT2' ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'barber')
      );
    }

    // Permite que cliente só altere campo de status para 'solicitado_cancelamento'
    function clientePodeCancelar() {
      return request.resource.data.keys().hasOnly(['status', 'updatedAt']) &&
             request.resource.data.status == 'solicitado_cancelamento';
    }

    // ========== COLEÇÃO: USUÁRIOS ==========
    match /users/{userId} {
      allow read: if isOwner(userId) || isMaster();
      allow create: if isOwner(userId);
      allow update: if isOwner(userId) && !request.resource.data.hasRole;
      allow delete: if isMaster();
    }

    // ========== COLEÇÃO: AGENDAMENTOS ==========
    match /appointments/{appointmentId} {
      // Leitura: dono do agendamento ou barbeiro
      allow read: if isAuthenticated() && (
        resource.data.userId == request.auth.uid ||
        resource.data.clientId == request.auth.uid ||
        isMaster()
      );

      // Criação: qualquer usuário logado
      allow create: if isAuthenticated() &&
        request.resource.data.status != 'confirmado' &&
        request.resource.data.status != 'concluido' &&
        request.resource.data.userId == request.auth.uid;

      // Atualização: dono pode pedir cancelamento; barbeiro pode tudo
      allow update: if isAuthenticated() && (
        (resource.data.userId == request.auth.uid && clientePodeCancelar()) ||
        isMaster()
      );

      // Exclusão: apenas barbeiro/master
      allow delete: if isMaster();
    }

    // ========== COLEÇÃO: NOTIFICAÇÕES ==========
    match /notifications/{notificationId} {
      allow read: if isAuthenticated() && (
        resource.data.toId == request.auth.uid || isMaster()
      );
      allow create: if isAuthenticated();
      allow update: if isAuthenticated() && (
        resource.data.toId == request.auth.uid || isMaster()
      );
      allow delete: if isMaster();
    }

    // ========== BLOQUEIO GERAL ==========
    match /{document=**} {
      allow read, write: if false;
    }
  }
}