rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Função utilitária para identificar Barbeiros / Masters
    function isMaster() {
      return request.auth != null && (
        request.auth.token.email in ['heitornmartins@gmail.com', 'darthbarber@darth.com.br'] ||
        request.auth.uid in ['wWlt2ixyjwfLqDHDQFFNQgaYfCT2'] || // Adicione UIDs específicos se necessário
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'barber'
      );
    }

    // Coleção de Notificações
    match /notifications/{notificationId} {
      // O usuário pode ler apenas as notificações destinadas a ele (toId == uid) OU se for Master/Barbeiro
      allow read: if request.auth != null && (
        resource.data.toId == request.auth.uid || isMaster()
      );
      
      // Permitir criar notificações (ex: quando um agendamento é feito)
      allow create: if request.auth != null;
      
      // Permitir atualizar (ex: marcar como lida) se for dono da notificação ou Master
      allow update: if request.auth != null && (
        resource.data.toId == request.auth.uid || isMaster()
      );

      // Apenas Master pode excluir
      allow delete: if isMaster();
    }

    // Demais coleções (users, appointments, etc)...
  }
}